<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Rep Support Agent Access</label>
    <description>Grants execute on the Rep Support agent's Apex actions plus Knowledge create/read. Assign to the agent run-as (Einstein Agent) user and to reps. Created for devtt testing; SF team owns the final prod permission set.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses>
        <apexClass>RepKnowledgeSearch</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>KnowledgeDraftBuilder</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>SFSupport_SlackTicketPost</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <objectPermissions>
        <object>Knowledge__kav</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
</PermissionSet>
