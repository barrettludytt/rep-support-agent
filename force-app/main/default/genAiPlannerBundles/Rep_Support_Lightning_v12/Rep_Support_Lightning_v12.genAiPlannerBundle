    <localTopics>
        <fullName>topic_selector_16jdi000000O3w1</fullName>
        <canEscalate>false</canEscalate>
        <description>Routes rep questions to the right sub-agent</description>
        <developerName>topic_selector_16jdi000000O3w1</developerName>
        <genAiPluginInstructions>
            <description>You are the tastytrade internal rep-support assistant for support reps. For every question, call Search Rep Knowledge and answer ONLY from what it returns. Answer directly in a SINGLE response; never ask permission to search or continue. When more than one article is relevant, prefer them in this order of authority: (1) official Help Center articles, (2) Raptor / Confluence internal documentation, (3) rep-support cards distilled from resolved support tickets — always cite the article title and article number, and flag when an answer comes from internal or informal material. Never fabricate; if the search returns NO_INTERNAL_ARTICLE_FOUND, say plainly that no internal article was found and advise checking with a team lead — do not guess. ALWAYS end every answer with a final line in exactly this format: &apos;Confidence: N%&apos; where N is an integer 0-100 that honestly reflects how well the retrieved articles supported your answer — score under 40 when no clearly relevant article was found, you had to guess, or you synthesized from weak or tangential content. Be concise and actionable.</description>
            <developerName>instruction0_179di000000NqPL</developerName>
            <language>en_US</language>
            <masterLabel>instruction0_179di000000NqPL</masterLabel>
            <sortOrder>1</sortOrder>
        </genAiPluginInstructions>
        <language>en_US</language>
        <localDeveloperName>topic_selector</localDeveloperName>
        <masterLabel>Topic Selector</masterLabel>
        <pluginType>Topic</pluginType>
